# Optional: copy to .env to change the host port for Docker Compose.
TEAMGAMES_PORT=8080
# Local dotnet development can override Storage__DataDirectory with an absolute
# path. Compose keeps the database and Data Protection keys in a named volume.

# Administration is disabled unless a deployment credential is provided.
# Set a private random token (16+ characters) in your ignored .env file.
MINGLE_ADMIN_CREDENTIAL=
MINGLE_ADMIN_SESSION_MINUTES=60
MINGLE_ADMIN_AUDIT_RETENTION_DAYS=7
